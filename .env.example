# ---- Database ----
DATABASE_URL=postgresql+asyncpg://wardrobe:wardrobe@localhost:5432/wardrobe
POSTGRES_USER=wardrobe
POSTGRES_PASSWORD=wardrobe
POSTGRES_DB=wardrobe

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- Object Storage (S3-compatible) ----
# Used by the API server itself. Under docker-compose this is overridden to the "minio"
# service name (see docker-compose.yml); localhost is correct when running the API outside
# Docker against a locally-running MinIO.
STORAGE_ENDPOINT=http://localhost:9000
# Baked into image URLs handed to the browser — always host-reachable, unlike STORAGE_ENDPOINT.
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_BUCKET=wardrobe-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# ---- LLM Provider (style intent parsing + outfit explanations) ----
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# ---- Vision Provider (garment analysis) ----
VISION_PROVIDER=mock
VISION_API_KEY=
VISION_MODEL=

# ---- Embedding Provider (garment/query embeddings) ----
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536

# ---- Virtual Try-On Provider ----
TRYON_PROVIDER=mock
TRYON_API_KEY=

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
# Used by the browser (runs on the host, outside Docker) — must be host-reachable.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Used by the web container's own server-side code (SSR) when running under docker-compose —
# must use the compose service name, not localhost. Ignored when running `next dev` outside
# Docker (falls back to NEXT_PUBLIC_API_BASE_URL in that case).
INTERNAL_API_BASE_URL=http://api:8000/api/v1
